# [1] RevenueCat Response: Inject Gold subscription + entitlements
locket_gold = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/Khanhslee/sgmodule/refs/heads/main/locketfix.js, requires-body=true, max-size=-1, timeout=60

# [2] RevenueCat Request: Xóa ETag để buộc server trả full response
locket_header = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/Khanhslee/sgmodule/refs/heads/main/locketheader.js, timeout=60

# [3] Firebase Remote Config: Inject feature_gates + video 60s + all Gold features
locket_features = type=http-response, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/.+, script-path=https://raw.githubusercontent.com/Khanhslee/sgmodule/refs/heads/main/forceGold4.2.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% api.revenuecat.com, firebaseremoteconfig.googleapis.com
